{
    "name": "nitro/framework",
    "description": "NitroPHP — a lean, fast, Laravel-shaped PHP framework.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/NitroFramework/framework",
    "authors": [
        {
            "name": "ZeeshanX4",
            "homepage": "https://github.com/ZeeshanX4",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/NitroFramework/framework/issues",
        "source": "https://github.com/NitroFramework/framework"
    },
    "require": {
        "php": "^8.2",
        "illuminate/container": "12.0",
        "laravel/serializable-closure": "^2.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Nitro\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/phpunit/phpunit/phpunit --testdox --colors=always",
        "analyse": "@php vendor/phpstan/phpstan/phpstan analyse --no-progress",
        "helpers": "Nitro\\Support\\HelperBundle::write",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "analyse": "Static analysis over src/.",
        "check": "Everything CI runs: analyse, then test."
    }
}
