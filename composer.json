{
    "name": "nitro/framework",
    "description": "NitroPHP — a lean, fast, Laravel-shaped PHP framework.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/NitroFramework/framework",
    "authors": [
        {
            "name": "ZeeshanX4",
            "homepage": "https://github.com/ZeeshanX4",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/NitroFramework/framework/issues",
        "source": "https://github.com/NitroFramework/framework"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Nitro\\": "src/"
        },
        "files": [
            "src/Support/Helpers/app.php",
            "src/Support/Helpers/config.php",
            "src/Support/Helpers/path.php",
            "src/Support/Helpers/array.php",
            "src/Support/Helpers/collection.php",
            "src/Support/Helpers/conditional.php",
            "src/Support/Helpers/debug.php",
            "src/Support/Helpers/file.php",
            "src/Support/Helpers/http.php",
            "src/Support/Helpers/request.php",
            "src/Support/Helpers/response.php",
            "src/Support/Helpers/security.php",
            "src/Support/Helpers/auth.php",
            "src/Support/Helpers/session.php",
            "src/Support/Helpers/string.php",
            "src/Support/Helpers/url.php",
            "src/Support/Helpers/utility.php",
            "src/Support/Helpers/validation.php",
            "src/Support/Helpers/view.php",
            "src/Support/Helpers/query.php",
            "src/Support/Helpers/cache.php",
            "src/Support/Helpers/cookie.php",
            "src/Support/Helpers/translation.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/phpunit/phpunit/phpunit --testdox --colors=always"
    }
}
